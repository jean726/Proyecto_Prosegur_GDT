<?xml version="1.0" encoding="utf-8" ?>
<!-- CU28 — Detalle de la hoja (diseño 3a–3c) y CU31 — confirmar recepción en hoja inferior (diseño 4a–4b). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProsegurGDT.Movil.ViewModels"
             xmlns:m="clr-namespace:ProsegurGDT.Movil.Models"
             xmlns:c="clr-namespace:ProsegurGDT.Movil.Controles"
             x:Class="ProsegurGDT.Movil.Views.HojaPage"
             x:DataType="vm:HojaViewModel"
             x:Name="Pagina">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Barra: volver y título -->
            <Grid ColumnDefinitions="48,*" ColumnSpacing="4" Padding="4,4,16,4" HeightRequest="56">
                <Grid Style="{StaticResource BotonIcono}" SemanticProperties.Description="Volver">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VolverCommand}" />
                    </Grid.GestureRecognizers>
                    <c:Icono Datos="{x:Static c:Iconos.Atras}" Color="{StaticResource TTexto}" Tamano="22" Grosor="2"
                             HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <Label Grid.Column="1" Text="Hoja de ruta" Style="{StaticResource TituloBarra}" />
            </Grid>

            <!-- Resumen: jornada, zona, estado y avance -->
            <VerticalStackLayout Grid.Row="1" Padding="20,4,20,16" Spacing="12" IsVisible="{Binding HayHoja}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Jornada}" Style="{StaticResource Mono}" TextColor="{StaticResource TTenue}" />
                        <Label Text="{Binding Zona}" Style="{StaticResource Titulo}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource ChipHoja}" BackgroundColor="{Binding FondoEstado}">
                        <Label Text="{Binding Estado}" FontFamily="PlexSemi" FontSize="13" TextColor="{Binding TextoEstado}" VerticalOptions="Center" />
                    </Border>
                </Grid>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Con resultado" Style="{StaticResource Tenue}" />
                        <Label Grid.Column="1" Text="{Binding Avance}" Style="{StaticResource Mono}" />
                    </Grid>
                    <c:BarraAvance Progreso="{Binding Progreso}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
            <BoxView Grid.Row="2" Style="{StaticResource Divisor}" />

            <RefreshView Grid.Row="3" IsRefreshing="{Binding Actualizando}" Command="{Binding CargarCommand}">
                <CollectionView ItemsSource="{Binding Visitas}" SelectionMode="None">

                    <CollectionView.Header>
                        <VerticalStackLayout>
                            <!-- Sin conexión -->
                            <Border Style="{StaticResource AvisoNeutro}" Margin="16,16,16,0" Padding="16,4,4,4" IsVisible="{Binding SinConexion}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <c:Icono Datos="{x:Static c:Iconos.SinSenal}" Color="{StaticResource TTexto}" Tamano="20" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Error}" FontFamily="PlexMedio" FontSize="14" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="Reintentar" Style="{StaticResource BotonTexto}" Command="{Binding CargarCommand}" />
                                </Grid>
                            </Border>

                            <!-- Error del servidor (T1) -->
                            <Border Style="{StaticResource AvisoRiesgo}" Margin="16,16,16,0" IsVisible="{Binding ErrorServidor}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <c:Icono Datos="{x:Static c:Iconos.Alerta}" Color="{StaticResource TRiesgoTexto}" Tamano="20" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding TituloError}" FontFamily="PlexSemi" TextColor="{StaticResource TRiesgoTitulo}" />
                                            <Label Text="{Binding Error}" FontSize="14" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Border Style="{StaticResource BotonContorno}" HeightRequest="48" Stroke="{StaticResource TRiesgoTexto}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CargarCommand}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <c:Icono Datos="{x:Static c:Iconos.Actualizar}" Color="{StaticResource TRiesgoTitulo}" Tamano="18" Grosor="2" VerticalOptions="Center" />
                                            <Label Text="Reintentar" FontFamily="PlexSemi" TextColor="{StaticResource TRiesgoTitulo}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 3a: confirmar la recepción antes de iniciar la ruta (RN-06) -->
                            <Border Margin="16,16,16,0" Padding="16" BackgroundColor="{StaticResource TSuperficie2}"
                                    Stroke="{StaticResource TAmarillo}" StrokeShape="RoundRectangle 12" IsVisible="{Binding PorConfirmar}">
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <c:Icono Datos="{x:Static c:Iconos.Info}" Color="{StaticResource TAmarillo}" Tamano="20" VerticalOptions="Start" Margin="0,2,0,0" />
                                        <Label Grid.Column="1" Text="Confirma la recepción de la hoja antes de iniciar la ruta"
                                               FontFamily="PlexSemi" FontSize="16" LineHeight="1.2" />
                                    </Grid>
                                    <Button Text="Confirmar recepción" Command="{Binding PedirConfirmacionCommand}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 3c: descargo iniciado -->
                            <Border Style="{StaticResource AvisoNeutro}" Margin="16,16,16,0" IsVisible="{Binding DescargoIniciado}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <c:Icono Datos="{x:Static c:Iconos.Candado}" Color="{StaticResource TTenue}" Tamano="20" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="Descargo iniciado: ya no se pueden modificar resultados"
                                           FontFamily="PlexMedio" LineHeight="1.2" />
                                </Grid>
                            </Border>

                            <Label Text="{Binding TituloVisitas}" Style="{StaticResource Seccion}" Padding="20,16,20,8" IsVisible="{Binding HayHoja}" />
                            <BoxView Style="{StaticResource Divisor}" IsVisible="{Binding HayHoja}" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <!-- Fila de visita (3a–3c) -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:VisitaItem">
                            <VerticalStackLayout BackgroundColor="{Binding FondoFila}" Opacity="{Binding Opacidad}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.AbrirVisitaCommand, Source={x:Reference Pagina}, x:DataType=ContentPage}"
                                                          CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14" Padding="20,14,12,14">
                                    <VerticalStackLayout Spacing="8" VerticalOptions="Start">
                                        <Label Text="{Binding Orden}" FontFamily="MonoSemi" FontSize="22" TextColor="{Binding ColorOrden}" />
                                        <c:Pulso IsVisible="{Binding EsSiguiente}" Margin="-5,0,0,0" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding Titular}" FontFamily="PlexSemi" FontSize="16" />
                                        <Label Text="{Binding Direccion}" FontSize="14" TextColor="{StaticResource TTenue}" />
                                        <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,4,0,0">
                                            <Label Text="{Binding Hora}" FontFamily="{Binding FuenteHora}" FontSize="14" TextColor="{Binding ColorHora}"
                                                   IsVisible="{Binding MostrarHora}" VerticalOptions="Center" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource Chip}" BackgroundColor="{Binding Chip.Fondo}" Stroke="{Binding Chip.Borde}" Margin="0,2,8,2">
                                                <Label Text="{Binding Resultado}" Style="{StaticResource ChipTexto}" TextColor="{Binding Chip.Texto}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" IsVisible="{Binding HaySuplantacion}" Margin="0,2,0,2"
                                                    BackgroundColor="{Binding ChipRiesgo.Fondo}" Stroke="{Binding ChipRiesgo.Borde}">
                                                <Label Text="{Binding Suplantacion}" Style="{StaticResource ChipTexto}" TextColor="{Binding ChipRiesgo.Texto}" />
                                            </Border>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                    <c:Icono Grid.Column="2" Datos="{x:Static c:Iconos.Siguiente}" Tamano="20" VerticalOptions="Center"
                                             Color="{StaticResource TTenue2}" IsVisible="{Binding MostrarFlecha}" />
                                </Grid>
                                <BoxView Style="{StaticResource Divisor}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- 4a / 4b: hoja inferior de confirmación -->
        <Grid IsVisible="{Binding HayHojaInferior}" BackgroundColor="{StaticResource TVelo}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarHojaInferiorCommand}" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource HojaInferior}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="20">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="{StaticResource TBordeFuerte}" HorizontalOptions="Center" />

                    <!-- 4a: confirmar -->
                    <VerticalStackLayout Spacing="20" IsVisible="{Binding MostrarConfirmar}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Confirmar recepción" FontFamily="PlexSemi" FontSize="21" />
                            <Label Text="Confirma que recibiste todas las tarjetas de esta hoja de ruta." TextColor="{StaticResource TTenue}" LineHeight="1.3" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="{StaticResource TFondo}" Stroke="{StaticResource TBorde}" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*" Padding="16,14">
                                    <Label Text="Jornada" TextColor="{StaticResource TTenue}" />
                                    <Label Grid.Column="1" Text="{Binding Jornada}" FontFamily="MonoMedio" HorizontalOptions="End" />
                                </Grid>
                                <BoxView Style="{StaticResource Divisor}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,14">
                                    <Label Text="Zona" TextColor="{StaticResource TTenue}" />
                                    <Label Grid.Column="1" Text="{Binding Zona}" FontFamily="PlexMedio" HorizontalOptions="End" HorizontalTextAlignment="End" />
                                </Grid>
                                <BoxView Style="{StaticResource Divisor}" />
                                <Grid ColumnDefinitions="Auto,*" Padding="16,10">
                                    <Label Text="Tarjetas" TextColor="{StaticResource TTenue}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Tarjetas}" FontFamily="MonoSemi" FontSize="22"
                                           TextColor="{StaticResource TAmarillo}" HorizontalOptions="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Spacing="10">
                            <Grid>
                                <Button Text="Confirmar recepción conforme" Command="{Binding ConfirmarCommand}" IsEnabled="{Binding Libre}" />
                                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource TTenue}"
                                                   WidthRequest="20" HeightRequest="20" HorizontalOptions="End" Margin="0,0,16,0" />
                            </Grid>
                            <Button Text="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CerrarHojaInferiorCommand}" IsEnabled="{Binding Libre}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- 4b: confirmada -->
                    <VerticalStackLayout Spacing="20" IsVisible="{Binding MostrarConfirmada}">
                        <Border WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26" HorizontalOptions="Start"
                                BackgroundColor="{StaticResource TAmarillo}">
                            <c:Icono Datos="{x:Static c:Iconos.Check}" Color="{StaticResource TFondo}" Tamano="26" Grosor="2.4"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Recepción confirmada" FontFamily="PlexSemi" FontSize="21" />
                            <Label Text="Ya puedes iniciar la ruta y registrar resultados." TextColor="{StaticResource TTenue}" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="{StaticResource TFondo}" Stroke="{StaticResource TBorde}" StrokeShape="RoundRectangle 10"
                                Padding="16,14" IsVisible="{Binding HayFechaConfirmacion}">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="Confirmada el" TextColor="{StaticResource TTenue}" />
                                <Label Grid.Column="1" Text="{Binding FechaConfirmacion}" FontFamily="MonoMedio" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                        <Button Text="Entendido" Command="{Binding CerrarHojaInferiorCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
