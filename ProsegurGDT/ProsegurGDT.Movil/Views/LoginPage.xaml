<?xml version="1.0" encoding="utf-8" ?>
<!-- CU22 — Iniciar sesión. Estilo provisional con los tokens de la Torre; el definitivo sale de Claude Design. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProsegurGDT.Movil.ViewModels"
             x:Class="ProsegurGDT.Movil.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource TFondo}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,72,24,24" Spacing="16">

            <VerticalStackLayout Spacing="4" Margin="0,0,0,24">
                <Label Text="ProsegurGDT" FontSize="30" FontAttributes="Bold"
                       TextColor="{StaticResource TAmarillo}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="App del repartidor" FontSize="16" TextColor="{StaticResource TTenue}" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding HayAviso}" Padding="14,12"
                    BackgroundColor="{StaticResource TSuperficie2}" Stroke="{StaticResource TBorde}"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding Aviso}" TextColor="{StaticResource TTexto}" FontSize="14" />
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="Correo" TextColor="{StaticResource TTenue}" FontSize="14" />
                <Border BackgroundColor="{StaticResource TSuperficie}" Stroke="{StaticResource TBorde}"
                        StrokeShape="RoundRectangle 8" Padding="12,0">
                    <Entry Text="{Binding Correo}" Keyboard="Email" Placeholder="usuario@gdt.local"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                           ReturnType="Next" MinimumHeightRequest="48"
                           TextColor="{StaticResource TTexto}" PlaceholderColor="{StaticResource Gray500}"
                           IsEnabled="{Binding Libre}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Contraseña" TextColor="{StaticResource TTenue}" FontSize="14" />
                <Border BackgroundColor="{StaticResource TSuperficie}" Stroke="{StaticResource TBorde}"
                        StrokeShape="RoundRectangle 8" Padding="12,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding Contrasena}" IsPassword="{Binding ContrasenaOculta}"
                               ReturnType="Go" ReturnCommand="{Binding IngresarCommand}" MinimumHeightRequest="48"
                               TextColor="{StaticResource TTexto}" IsEnabled="{Binding Libre}" />
                        <Button Grid.Column="1" Text="{Binding TextoAlternar}"
                                Command="{Binding AlternarContrasenaCommand}"
                                BackgroundColor="Transparent" TextColor="{StaticResource TTenue}"
                                FontSize="14" Padding="8,0" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding Error}" IsVisible="{Binding HayError}"
                   TextColor="{StaticResource TRiesgo}" FontSize="14" />

            <Grid>
                <Button Text="Ingresar" Command="{Binding IngresarCommand}"
                        BackgroundColor="{StaticResource TAmarillo}" TextColor="{StaticResource TFondo}"
                        FontAttributes="Bold" FontSize="16" HeightRequest="52" CornerRadius="8" />
                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}"
                                   Color="{StaticResource TFondo}" HeightRequest="24" WidthRequest="24"
                                   HorizontalOptions="End" Margin="0,0,16,0" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
