<?xml version="1.0" encoding="UTF-8" ?>
<!-- Estilos de la app del repartidor según el diseño de Claude Design (Torre de control, 360 px).
     Fuentes (MauiProgram): Plex / PlexMedio / PlexSemi / PlexNegrita (IBM Plex Sans 400–700) y
     Mono / MonoMedio / MonoSemi (IBM Plex Mono 400–600). Con fuentes propias el peso va en la familia,
     no en FontAttributes. Botones y campos de 52 px (mínimo táctil 48 px). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Implícitos ===================== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource TFondo}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource TFondo}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TTexto}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource TTexto}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.FlyoutBehavior" Value="Disabled" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Plex" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TTexto}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{StaticResource TTexto}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Plex" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TTexto}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TTenue2}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Plex" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TTexto}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TTenue2}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="PlexSemi" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TFondo}" />
        <Setter Property="BackgroundColor" Value="{StaticResource TAmarillo}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource TBorde}" />
                            <Setter Property="TextColor" Value="{StaticResource TTenue2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource TAmarillo}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource TAmarillo}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ===================== Botones ===================== -->

    <!-- Acción principal: amarillo con texto oscuro (implícito). -->
    <Style x:Key="BotonPrimario" TargetType="Button" />

    <!-- Secundario: contorno gris (Corregir, Cancelar). -->
    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TTexto}" />
        <Setter Property="BorderColor" Value="{StaticResource TBordeFuerte}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Riesgo: «Enviar reporte» de suplantación. -->
    <Style x:Key="BotonRiesgo" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource TRiesgo}" />
        <Setter Property="TextColor" Value="{StaticResource TBlanco}" />
    </Style>

    <!-- Botón de texto (Reintentar en la franja sin conexión, Cancelar corrección). -->
    <Style x:Key="BotonTexto" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TAmarillo}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Fila de botón con icono (Llamar, Reintentar, Reportar suplantación): Border con TapGestureRecognizer. -->
    <Style x:Key="BotonContorno" TargetType="Border">
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Stroke" Value="{StaticResource TBordeFuerte}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Botón de icono de 48 × 48 (volver, cerrar sesión, mostrar contraseña). -->
    <Style x:Key="BotonIcono" TargetType="Grid">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ===================== Texto ===================== -->

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSemi" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="TituloBarra" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSemi" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexMedio" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TTenue}" />
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexMedio" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TTenue}" />
    </Style>

    <Style x:Key="Tenue" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TTenue}" />
    </Style>

    <!-- Encabezado de sección en mono y mayúsculas («VISITAS · 18», «REGISTRAR RESULTADO»). -->
    <Style x:Key="Seccion" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoSemi" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TTenue}" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="Mono" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoMedio" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Error bajo un campo. -->
    <Style x:Key="ErrorCampo" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexMedio" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TRiesgoTexto}" />
    </Style>

    <!-- ===================== Contenedores ===================== -->

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TSuperficie}" />
        <Setter Property="Stroke" Value="{StaticResource TBorde}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!-- Caja de un campo de texto (52 px); el borde se vuelve amarillo al enfocar (ResaltarAlEnfocar). -->
    <Style x:Key="Campo" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TSuperficie}" />
        <Setter Property="Stroke" Value="{StaticResource TBorde}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!-- Aviso de riesgo (errores del servidor, credenciales, suplantación). -->
    <Style x:Key="AvisoRiesgo" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TRiesgoFondo}" />
        <Setter Property="Stroke" Value="{StaticResource TRiesgoBorde}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Aviso neutro (descargo iniciado, bloqueos, documento distinto). -->
    <Style x:Key="AvisoNeutro" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TSuperficie2}" />
        <Setter Property="Stroke" Value="{StaticResource TBordeFuerte}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Hoja inferior (confirmar recepción) y diálogo centrado (cerrar sesión, sesión expirada). -->
    <Style x:Key="HojaInferior" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TSuperficie}" />
        <Setter Property="Stroke" Value="{StaticResource TBorde}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20,20,0,0" />
        <Setter Property="Padding" Value="20,10,20,28" />
        <Setter Property="VerticalOptions" Value="End" />
    </Style>

    <Style x:Key="Dialogo" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TSuperficie2}" />
        <Setter Property="Stroke" Value="{StaticResource TBorde}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="20,24,20,20" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Línea divisoria de 1 px. -->
    <Style x:Key="Divisor" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource TBorde}" />
    </Style>

    <!-- Bloque de esqueleto de carga. -->
    <Style x:Key="Esqueleto" TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource TSuperficie2}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Chip: el color de fondo, borde y texto lo pone la vista o el modelo de presentación. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ChipTexto" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSemi" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Chip de estado de la hoja (26 px): «Por confirmar» relleno, «En curso» con contorno. -->
    <Style x:Key="ChipHoja" TargetType="Border">
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 13" />
        <Setter Property="Stroke" Value="{StaticResource TAmarillo}" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>
</ResourceDictionary>
