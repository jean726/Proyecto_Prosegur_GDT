@model IEnumerable<ProsegurGDT.Web.Models.UsuarioFilaVM>
@{
    ViewData["Title"] = "Usuarios"; ViewData["Torre"] = true;
}
<div class="pg-encabezado">
    <div>
        <h1>Usuarios</h1>
        <p class="pg-subtitulo"><span id="pgTotal">@Model.Count()</span> usuarios registrados</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">+ Registrar usuario</a>
</div>
@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
<div class="pg-tarjeta pg-tarjeta-tabla">
    <div class="pg-barra-tabla">
        <input id="pgBuscar" type="search" class="form-control" placeholder="Buscar por nombre, usuario o rol" autocomplete="off" />
    </div>
    <table id="pgTabla" class="table table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                var clave = $"{u.NombreCompleto} {u.Email} {u.Rol} {ProsegurGDT.Web.Domain.Roles.Etiqueta(u.Rol)}".ToLowerInvariant();
                <tr data-buscar="@clave">
                    <td>@u.NombreCompleto</td>
                    <td>@u.Email</td>
                    <td>@ProsegurGDT.Web.Domain.Roles.Etiqueta(u.Rol)</td>
                    <td>
                        @if (!u.Activo)
                        {
                            <span class="badge bg-secondary">Desactivado</span>
                        }
                        else if (u.Bloqueado)
                        {
                            <span class="badge bg-warning">Bloqueado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Modificar</a>
                        @if (u.Bloqueado)
                        {
                            <form asp-action="Desbloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-warning">Desbloquear</button>
                            </form>
                        }
                        @if (u.Activo)
                        {
                            <form asp-action="Desactivar" asp-route-id="@u.Id" method="post" class="d-inline"
                                  data-confirmar="Esta acción desactivará su acceso al sistema. ¿Continuar?">
                                <button class="btn btn-sm btn-outline-danger">Desactivar</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Reactivar" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-success">Reactivar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            <tr id="pgVacio" hidden><td colspan="5" class="text-center text-muted py-4">No se encontraron usuarios.</td></tr>
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        (function () {
            var q = document.getElementById('pgBuscar');
            var filas = document.querySelectorAll('#pgTabla tbody tr[data-buscar]');
            var total = document.getElementById('pgTotal');
            var vacio = document.getElementById('pgVacio');
            q.addEventListener('input', function () {
                var t = q.value.trim().toLowerCase(), n = 0;
                filas.forEach(function (f) {
                    var ok = f.getAttribute('data-buscar').indexOf(t) !== -1;
                    f.hidden = !ok;
                    if (ok) n++;
                });
                total.textContent = n;
                vacio.hidden = n !== 0;
            });
        })();
    </script>
}