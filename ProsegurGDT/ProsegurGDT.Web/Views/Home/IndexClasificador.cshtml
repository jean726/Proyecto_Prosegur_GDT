@model ProsegurGDT.Web.Models.DashboardClasificadorViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Torre"] = true;

    string Pl(int n, string singular, string plural) => n == 1 ? singular : plural;

    var titular = Model.PorClasificar > 0
        ? $"{Model.PorClasificar} {Pl(Model.PorClasificar, "tarjeta por clasificar", "tarjetas por clasificar")}."
        : (Model.YaClasificadas > 0 ? "Clasificación al día." : "Todo al día.");
    var riesgo = Model.NoClasificables > 0
        ? $"{Model.NoClasificables} {Pl(Model.NoClasificables, "no clasificable por dirección con alerta", "no clasificables por dirección con alerta")}."
        : "";

    var accion = Model.PorClasificar > 0
        ? (Titulo: $"Clasificar {Model.PorClasificar} {Pl(Model.PorClasificar, "tarjeta", "tarjetas")} por zona", Detalle: "Las tarjetas con alerta de dirección quedan bloqueadas hasta que el Buscador decida.", Boton: "Ir a clasificar", Ctrl: "Clasificacion", Act: "Index", Id: (int?)null)
        : (Titulo: "No hay tarjetas por clasificar", Detalle: "Cuando ingrese un lote nuevo aparecerá aquí.", Boton: "Ir a clasificar", Ctrl: "Clasificacion", Act: "Index", Id: (int?)null);

    var placas = new (string Etiqueta, int Valor, string Tono)[]
    {
        ("Por clasificar", Model.PorClasificar, "cola"),
        ("Ya clasificadas", Model.YaClasificadas, "ok"),
        ("No clasificables", Model.NoClasificables, "riesgo")
    };
}

@await Html.PartialAsync("_TorreCab", (Rol: "del clasificador", Titular: titular, Riesgo: riesgo, Sub: "Tarjetas pendientes de clasificar y bloqueadas por riesgo", Boton: "Ir a clasificar", Ctrl: "Clasificacion", Act: "Index"))
@await Html.PartialAsync("_TorreTira", new[] { 2 })
@await Html.PartialAsync("_TorreAccion", accion)
@await Html.PartialAsync("_TorrePlacas", placas)

<section class="pg-t-panel pg-t-bloque" aria-label="Tarjetas no clasificables">
    <div class="pg-t-panel-cab">
        <h2>Tarjetas no clasificables</h2>
        <a asp-controller="DireccionesFraudulentas" asp-action="Index">Ver direcciones fraudulentas →</a>
    </div>
    @if (Model.CodigosNoClasificables.Count == 0)
    {
        <p class="pg-t-bloque-vacio">No hay tarjetas no clasificables.</p>
    }
    else
    {
        <table class="pg-t-tabla apilada">
            <thead><tr><th>Tarjeta</th><th>Motivo</th><th>Estado</th></tr></thead>
            <tbody>
                @{ var fila = 0; }
                @foreach (var codigo in Model.CodigosNoClasificables)
                {
                    <tr style="--f:@(fila++)">
                        <td class="pg-t-mono fuerte" data-etiqueta="Tarjeta">@codigo</td>
                        <td data-etiqueta="Motivo">Dirección con alerta</td>
                        <td data-etiqueta="Estado"><span class="pg-t-estado pg-t-estado-riesgo"><span class="pg-t-punto"></span>No clasificable</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
