@model ProsegurGDT.Web.Models.DashboardAnalistaViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="pg-dash-cab">
    <div>
        <h1>Inicio</h1>
        <p>Reportes de densidad por asignar y carga de los repartidores hoy</p>
    </div>
    <a asp-controller="Asignaciones" asp-action="Index" class="btn btn-primary">Hojas de asignación</a>
</div>

@if (Model.ReportesPendientes > 0)
{
    <div class="pg-aviso">
        @Model.ReportesPendientes @(Model.ReportesPendientes == 1 ? "lote espera" : "lotes esperan") su hoja de asignación
    </div>
}

<div class="pg-metricas">
    <div class="pg-tarjeta pg-metrica pg-metrica-riesgo"><small>Reportes por asignar</small><strong>@Model.ReportesPendientes</strong></div>
    <div class="pg-tarjeta pg-metrica pg-metrica-azul"><small>Hojas emitidas hoy</small><strong>@Model.HojasHoy</strong></div>
    <div class="pg-tarjeta pg-metrica pg-metrica-ok"><small>Tarjetas en ruta hoy</small><strong>@Model.TarjetasEnRutaHoy</strong></div>
    <div class="pg-tarjeta pg-metrica"><small>Repartidores activos</small><strong>@Model.RepartidoresActivos</strong></div>
</div>

<div class="pg-tarjeta pg-bloque mb-3">
    <h2 class="h6 mb-2">Lotes pendientes de hoja</h2>
    @if (Model.Pendientes.Count == 0)
    {
        <p class="text-muted mb-2">No hay reportes de densidad pendientes.</p>
    }
    else
    {
        <table class="table mb-2">
            <thead><tr><th>Hoja de control</th><th>Remito</th><th class="text-end">Zonas</th><th>Reporte</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model.Pendientes)
                {
                    <tr>
                        <td>@p.HojaControl</td>
                        <td>@p.Remito</td>
                        <td class="text-end">@p.Zonas</td>
                        <td>@p.Estado</td>
                        <td class="text-end"><a asp-controller="Asignaciones" asp-action="Generar" asp-route-id="@p.LoteId">Generar hoja →</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="pg-tarjeta pg-bloque">
    <h2 class="h6 mb-2">Carga de repartidores hoy</h2>
    @if (Model.Cargas.Count == 0)
    {
        <p class="text-muted mb-0">No hay repartidores activos.</p>
    }
    else
    {
        <table class="table mb-0">
            <thead><tr><th>Repartidor</th><th>Tipo</th><th class="text-end">Asignadas</th><th class="text-end">Capacidad</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Cargas)
                {
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@c.Tipo</td>
                        <td class="text-end">@c.Asignadas</td>
                        <td class="text-end">@(c.Asignadas > c.Capacidad ? Html.Raw($"<span class=\"pg-estado pg-estado-riesgo\">{c.Capacidad}</span>") : Html.Raw(c.Capacidad.ToString()))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
