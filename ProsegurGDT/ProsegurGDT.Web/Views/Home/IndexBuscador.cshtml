@model ProsegurGDT.Web.Models.DashboardBuscadorViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Torre"] = true;

    string Pl(int n, string singular, string plural) => n == 1 ? singular : plural;

    string titular;
    if (Model.AlertasPendientes > 0)
        titular = $"{Model.AlertasPendientes} {Pl(Model.AlertasPendientes, "alerta espera", "alertas esperan")} tu decisión.";
    else if (Model.DireccionesPorValidar > 0)
        titular = $"{Model.DireccionesPorValidar} {Pl(Model.DireccionesPorValidar, "dirección por validar", "direcciones por validar")}.";
    else
        titular = "Todo al día.";

    var primera = Model.AlertasCriticas.FirstOrDefault();
    var accion = primera != null
        ? (Titulo: $"Alerta más crítica: tarjeta {primera.Tarjeta}", Detalle: $"Coincide con {primera.Direccion} · similitud {primera.Puntaje:P0}", Boton: "Revisar alertas", Ctrl: "DireccionesFraudulentas", Act: "Alertas", Id: (int?)null)
        : (Titulo: "No hay alertas pendientes", Detalle: "El registro de direcciones está al día.", Boton: "Ver alertas", Ctrl: "DireccionesFraudulentas", Act: "Alertas", Id: (int?)null);

    var placas = new (string Etiqueta, int Valor, string Tono)[]
    {
        ("Alertas pendientes", Model.AlertasPendientes, "riesgo"),
        ("Direcciones por validar", Model.DireccionesPorValidar, "cola"),
        ("Direcciones validadas", Model.DireccionesValidadas, "ok")
    };
}

@await Html.PartialAsync("_TorreCab", (Rol: "del buscador", Titular: titular, Riesgo: "", Sub: "Alertas por revisar y estado del registro de direcciones", Boton: "Revisar alertas", Ctrl: "DireccionesFraudulentas", Act: "Alertas"))
@await Html.PartialAsync("_TorreTira", new[] { 2 })
@await Html.PartialAsync("_TorreAccion", accion)
@await Html.PartialAsync("_TorrePlacas", placas)

<section class="pg-t-panel pg-t-bloque" aria-label="Alertas más críticas">
    <div class="pg-t-panel-cab">
        <h2>Alertas más críticas</h2>
        <a asp-controller="DireccionesFraudulentas" asp-action="Alertas">Ver todas las alertas →</a>
    </div>
    @if (Model.AlertasCriticas.Count == 0)
    {
        <p class="pg-t-bloque-vacio">No hay alertas pendientes.</p>
    }
    else
    {
        <table class="pg-t-tabla apilada">
            <thead><tr><th>Tarjeta</th><th>Coincide con</th><th>Similitud</th></tr></thead>
            <tbody>
                @{ var fila = 0; }
                @foreach (var a in Model.AlertasCriticas)
                {
                    var tono = a.Puntaje >= 0.90 ? "riesgo" : "pendiente";
                    <tr style="--f:@(fila++)">
                        <td class="pg-t-mono fuerte" data-etiqueta="Tarjeta">@a.Tarjeta</td>
                        <td data-etiqueta="Coincide con">@a.Direccion</td>
                        <td data-etiqueta="Similitud"><span class="pg-t-estado pg-t-estado-@tono"><span class="pg-t-punto"></span>@a.Puntaje.ToString("P0")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
