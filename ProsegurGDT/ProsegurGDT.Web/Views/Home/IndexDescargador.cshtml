@model ProsegurGDT.Web.Models.DashboardDescargadorViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Torre"] = true;

    string Pl(int n, string singular, string plural) => n == 1 ? singular : plural;

    var titular = Model.RutasPorProcesar > 0
        ? $"{Model.RutasPorProcesar} {Pl(Model.RutasPorProcesar, "ruta por descargar", "rutas por descargar")}."
        : "Todo al día.";
    var riesgo = Model.FraudePorRegistrar > 0
        ? $"{Model.FraudePorRegistrar} {Pl(Model.FraudePorRegistrar, "tarjeta espera", "tarjetas esperan")} su acta de fraude."
        : "";

    var primera = Model.Rutas.FirstOrDefault();
    var accion = primera != null
        ? (Titulo: $"Procesar la ruta de {primera.Repartidor}", Detalle: $"{primera.Sector} · {primera.Pendientes} por verificar · {primera.Estado}", Boton: "Procesar ruta", Ctrl: "Descargo", Act: "Procesar", Id: (int?)primera.HojaRutaId)
        : (Titulo: "No hay rutas pendientes", Detalle: "Aparecerán cuando haya hojas firmadas en un reporte de entregas remitido.", Boton: "Descargo de tarjetas", Ctrl: "Descargo", Act: "Index", Id: (int?)null);

    var placas = new (string Etiqueta, int Valor, string Tono)[]
    {
        ("Rutas por procesar", Model.RutasPorProcesar, "cola"),
        ("Tarjetas por verificar", Model.TarjetasPendientes, "cola"),
        ("Rutas cerradas", Model.RutasCerradas, "ok"),
        ("Reportes generados", Model.ReportesGenerados, "neu")
    };
}

@await Html.PartialAsync("_TorreCab", (Rol: "del descargador", Titular: titular, Riesgo: riesgo, Sub: "Rutas por descargar, apartado de defraudación y reportes de la jornada", Boton: "Descargo de tarjetas", Ctrl: "Descargo", Act: "Index"))
@await Html.PartialAsync("_TorreTira", new[] { 4 })
@await Html.PartialAsync("_TorreAccion", accion)
@await Html.PartialAsync("_TorrePlacas", placas)

<section class="pg-t-panel pg-t-bloque" aria-label="Rutas pendientes de descargo">
    <div class="pg-t-panel-cab">
        <h2>Rutas pendientes de descargo</h2>
    </div>
    @if (Model.Rutas.Count == 0)
    {
        <p class="pg-t-bloque-vacio">No hay rutas pendientes.</p>
    }
    else
    {
        <table class="pg-t-tabla apilada">
            <thead><tr><th>Repartidor</th><th>Sector</th><th class="num">Por verificar</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @{ var fila = 0; }
                @foreach (var r in Model.Rutas)
                {
                    <tr style="--f:@(fila++)">
                        <td class="fuerte" data-etiqueta="Repartidor">@r.Repartidor</td>
                        <td data-etiqueta="Sector">@r.Sector</td>
                        <td class="num pg-t-mono @(r.Pendientes == 0 ? "pg-t-tenue" : "")" data-etiqueta="Por verificar">@r.Pendientes</td>
                        <td data-etiqueta="Estado"><span class="pg-t-estado pg-t-estado-neutro"><span class="pg-t-punto"></span>@r.Estado</span></td>
                        <td class="acc"><a asp-controller="Descargo" asp-action="Procesar" asp-route-id="@r.HojaRutaId">Procesar →</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div class="pg-t-pie">
        <a asp-controller="ReportesDescargo" asp-action="Index">Reportes de descargo →</a>
        <a asp-controller="Defraudacion" asp-action="Index">Apartado de defraudación →</a>
    </div>
</section>
