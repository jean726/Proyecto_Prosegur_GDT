@model ProsegurGDT.Web.Models.DashboardBovedaViewModel
@using ProsegurGDT.Web.Domain
@{
    ViewData["Title"] = "Inicio";
    ViewData["Torre"] = true;

    string Pl(int n, string singular, string plural) => n == 1 ? singular : plural;

    var titular = Model.FraudePorIngresar > 0 ? "" : "Bóveda al día.";
    var riesgo = Model.FraudePorIngresar > 0
        ? $"{Model.FraudePorIngresar} {Pl(Model.FraudePorIngresar, "tarjeta de fraude espera", "tarjetas de fraude esperan")} su ingreso a bóveda."
        : "";

    var primera = Model.Pendientes.FirstOrDefault();
    var accion = primera != null
        ? (Titulo: $"Ingresar la tarjeta {primera.Codigo}", Detalle: $"{primera.Cliente} · {primera.Origen.Texto()} · registrada {HoraLima.Convertir(primera.FechaRegistro):dd/MM/yyyy HH:mm}", Boton: "Registrar ingresos", Ctrl: "Defraudacion", Act: "Index", Id: (int?)null)
        : (Titulo: "No hay tarjetas pendientes de ingreso", Detalle: "Las actas de fraude registradas por el Descargador aparecerán aquí.", Boton: "Inventario de bóveda", Ctrl: "Defraudacion", Act: "Inventario", Id: (int?)null);

    var placas = new (string Etiqueta, int Valor, string Tono)[]
    {
        ("Fraude por ingresar", Model.FraudePorIngresar, "riesgo"),
        ("Ingresadas hoy", Model.IngresadasHoy, "ok"),
        ("Tarjetas en bóveda", Model.InventarioTotal, "info"),
        ("Con etiqueta de fraude", Model.InventarioFraude, "neu")
    };
}

@await Html.PartialAsync("_TorreCab", (Rol: "de la bóveda", Titular: titular, Riesgo: riesgo, Sub: "Tarjetas de fraude por ingresar y estado del inventario de bóveda", Boton: "Apartado de defraudación", Ctrl: "Defraudacion", Act: "Index"))
@await Html.PartialAsync("_TorreTira", new[] { 4 })
@await Html.PartialAsync("_TorreAccion", accion)
@await Html.PartialAsync("_TorrePlacas", placas)

<section class="pg-t-panel pg-t-bloque" aria-label="Próximas a ingresar">
    <div class="pg-t-panel-cab">
        <h2>Próximas a ingresar</h2>
    </div>
    @if (Model.Pendientes.Count == 0)
    {
        <p class="pg-t-bloque-vacio">No hay tarjetas pendientes de ingreso.</p>
    }
    else
    {
        <table class="pg-t-tabla apilada">
            <thead><tr><th>Tarjeta</th><th>Titular</th><th>Origen</th><th>Registrada</th></tr></thead>
            <tbody>
                @{ var fila = 0; }
                @foreach (var a in Model.Pendientes)
                {
                    <tr style="--f:@(fila++)">
                        <td class="pg-t-mono fuerte" data-etiqueta="Tarjeta">@a.Codigo</td>
                        <td data-etiqueta="Titular">@a.Cliente</td>
                        <td data-etiqueta="Origen">@a.Origen.Texto()</td>
                        <td class="pg-t-mono pg-t-tenue" data-etiqueta="Registrada">@HoraLima.Convertir(a.FechaRegistro).ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div class="pg-t-pie">
        <a asp-controller="Defraudacion" asp-action="Index">Registrar ingresos →</a>
        <a asp-controller="Defraudacion" asp-action="Inventario">Inventario de bóveda →</a>
    </div>
</section>
