@model ProsegurGDT.Web.Models.DashboardAdminViewModel
@{
    ViewData["Title"] = "Inicio";
    var maxRol = Model.PorRol.Count > 0 ? Model.PorRol.Max(r => r.Total) : 1;
}

<div class="pg-dash-cab">
    <div>
        <h1>Inicio</h1>
        <p>Resumen de cuentas y actividad del sistema</p>
    </div>
    <a asp-controller="Usuarios" asp-action="Crear" class="btn btn-primary">+ Nuevo usuario</a>
</div>

<div class="pg-metricas">
    <div class="pg-tarjeta pg-metrica pg-metrica-ok"><small>Cuentas activas</small><strong>@Model.Activas</strong></div>
    <div class="pg-tarjeta pg-metrica pg-metrica-off"><small>Desactivadas</small><strong>@Model.Desactivadas</strong></div>
    <div class="pg-tarjeta pg-metrica pg-metrica-riesgo"><small>Bloqueadas ahora</small><strong>@Model.Bloqueadas</strong></div>
</div>

<div class="pg-dash-cols">
    <div class="pg-tarjeta">
        <h2 class="h6 mb-3">Usuarios por rol</h2>
        @if (Model.PorRol.Count == 0)
        {
            <p class="text-muted mb-0">Aún no hay usuarios con rol asignado.</p>
        }
        @foreach (var f in Model.PorRol)
        {
            var ancho = (int)Math.Round(100.0 * f.Total / maxRol);
            <div class="pg-barra-fila">
                <span>@f.Rol</span>
                <div class="pg-barra-pista"><span style="width:@(ancho)%"></span></div>
                <span>@f.Total</span>
            </div>
        }
    </div>

    <div class="pg-tarjeta">
        <h2 class="h6 mb-2">Últimas acciones</h2>
        @if (Model.UltimasAcciones.Count == 0)
        {
            <p class="text-muted mb-0">Todavía no hay acciones registradas.</p>
        }
        @foreach (var a in Model.UltimasAcciones)
        {
            <div class="pg-accion-fila">
                <span class="pg-accion-etiqueta">@a.Accion</span>
                <span>@a.Usuario@(string.IsNullOrWhiteSpace(a.Detalle) ? "" : " · " + a.Detalle)</span>
                <small class="text-muted">@a.FechaLocal.ToString("dd/MM HH:mm")</small>
            </div>
        }
        <div class="mt-3"><a asp-controller="Auditoria" asp-action="Index">Ver toda la auditoría →</a></div>
    </div>
</div>