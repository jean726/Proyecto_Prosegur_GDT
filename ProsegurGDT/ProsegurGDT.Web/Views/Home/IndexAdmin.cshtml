@model ProsegurGDT.Web.Models.DashboardAdminViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Torre"] = true;

    string Pl(int n, string singular, string plural) => n == 1 ? singular : plural;

    var maxRol = Model.PorRol.Count > 0 ? Model.PorRol.Max(r => r.Total) : 1;
    var titular = $"{Model.Activas} {Pl(Model.Activas, "cuenta activa", "cuentas activas")}.";
    var riesgo = Model.Bloqueadas > 0
        ? $"{Model.Bloqueadas} {Pl(Model.Bloqueadas, "bloqueada", "bloqueadas")} ahora."
        : "";

    var placas = new (string Etiqueta, int Valor, string Tono)[]
    {
        ("Cuentas activas", Model.Activas, "ok"),
        ("Desactivadas", Model.Desactivadas, "neu"),
        ("Bloqueadas ahora", Model.Bloqueadas, "riesgo")
    };
}

@await Html.PartialAsync("_TorreCab", (Rol: "del administrador", Titular: titular, Riesgo: riesgo, Sub: "Resumen de cuentas y actividad del sistema", Boton: "+ Nuevo usuario", Ctrl: "Usuarios", Act: "Crear"))
@await Html.PartialAsync("_TorrePlacas", placas)

<div class="pg-t-cols">
    <section class="pg-t-panel pg-t-lotes" aria-label="Usuarios por rol">
        <div class="pg-t-panel-cab"><h2>Usuarios por rol</h2></div>
        @if (Model.PorRol.Count == 0)
        {
            <p class="pg-t-bloque-vacio">Aún no hay usuarios con rol asignado.</p>
        }
        else
        {
            <div class="pg-t-roles">
                @{ var fr = 0; }
                @foreach (var f in Model.PorRol)
                {
                    var ancho = (int)Math.Round(100.0 * f.Total / maxRol);
                    <div class="pg-t-rol">
                        <span>@f.Rol</span>
                        <span class="pg-t-medidor" style="--v:@ancho;--f:@(fr++)"><i></i></span>
                        <span class="pg-t-rol-n">@f.Total</span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="pg-t-panel pg-t-lotes" aria-label="Últimas acciones">
        <div class="pg-t-panel-cab">
            <h2>Últimas acciones</h2>
            <a asp-controller="Auditoria" asp-action="Index">Ver toda la auditoría →</a>
        </div>
        @if (Model.UltimasAcciones.Count == 0)
        {
            <p class="pg-t-bloque-vacio">Todavía no hay acciones registradas.</p>
        }
        else
        {
            <div class="pg-t-acciones">
                @foreach (var a in Model.UltimasAcciones)
                {
                    <div class="pg-t-accion-fila">
                        <span class="pg-t-accion-etiq">@a.Accion</span>
                        <span>@a.Usuario@(string.IsNullOrWhiteSpace(a.Detalle) ? "" : " · " + a.Detalle)</span>
                        <span class="pg-t-hora">@a.FechaLocal.ToString("dd/MM HH:mm")</span>
                    </div>
                }
            </div>
        }
    </section>
</div>
