@model ProsegurGDT.Web.Models.DashboardTelefonistaViewModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Torre"] = true;

    string Pl(int n, string singular, string plural) => n == 1 ? singular : plural;

    string titular;
    if (Model.PendientesContacto > 0)
        titular = $"{Model.PendientesContacto} {Pl(Model.PendientesContacto, "tarjeta espera", "tarjetas esperan")} tu llamada.";
    else if (Model.CitasProgramadas > 0)
        titular = $"{Model.CitasProgramadas} {Pl(Model.CitasProgramadas, "cita programada", "citas programadas")}.";
    else
        titular = "Todo al día.";
    var sub = Model.IntentosAgotados > 0
        ? $"{Model.IntentosAgotados} {Pl(Model.IntentosAgotados, "tarjeta con intentos agotados ya está escalada", "tarjetas con intentos agotados ya están escaladas")} al Supervisor."
        : "Contactos pendientes y citas programadas";

    var primera = Model.ProximasCitas.FirstOrDefault();
    var accion = primera != null
        ? (Titulo: $"Próxima cita: {primera.Cliente}", Detalle: $"{primera.Tarjeta} · {primera.Fecha:dd/MM} {primera.Hora:HH:mm}", Boton: "Gestionar citas", Ctrl: "Citas", Act: "Index", Id: (int?)null)
        : (Titulo: "No hay citas próximas", Detalle: "Registra el resultado de tus llamadas para programar nuevas citas.", Boton: "Gestionar citas", Ctrl: "Citas", Act: "Index", Id: (int?)null);

    var placas = new (string Etiqueta, int Valor, string Tono)[]
    {
        ("Pendientes de contacto", Model.PendientesContacto, "cola"),
        ("Intentos agotados", Model.IntentosAgotados, "info"),
        ("Citas programadas", Model.CitasProgramadas, "ok")
    };
}

@await Html.PartialAsync("_TorreCab", (Rol: "de la telefonista", Titular: titular, Riesgo: "", Sub: sub, Boton: "Gestionar citas", Ctrl: "Citas", Act: "Index"))
@await Html.PartialAsync("_TorreTira", new[] { 1, 2 })
@await Html.PartialAsync("_TorreAccion", accion)
@await Html.PartialAsync("_TorrePlacas", placas)

<section class="pg-t-panel pg-t-bloque" aria-label="Próximas citas">
    <div class="pg-t-panel-cab">
        <h2>Próximas citas</h2>
        <a asp-controller="Citas" asp-action="Index">Ir a citas con clientes →</a>
    </div>
    @if (Model.ProximasCitas.Count == 0)
    {
        <p class="pg-t-bloque-vacio">No hay citas próximas.</p>
    }
    else
    {
        <table class="pg-t-tabla apilada">
            <thead><tr><th>Tarjeta</th><th>Cliente</th><th>Fecha y hora</th><th>Estado</th></tr></thead>
            <tbody>
                @{ var fila = 0; }
                @foreach (var c in Model.ProximasCitas)
                {
                    <tr style="--f:@(fila++)">
                        <td class="pg-t-mono fuerte" data-etiqueta="Tarjeta">@c.Tarjeta</td>
                        <td data-etiqueta="Cliente">@c.Cliente</td>
                        <td class="pg-t-mono pg-t-tenue" data-etiqueta="Fecha y hora">@c.Fecha.ToString("dd/MM") @c.Hora.ToString("HH:mm")</td>
                        <td data-etiqueta="Estado"><span class="pg-t-estado pg-t-estado-custodia"><span class="pg-t-punto"></span>Programada</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
