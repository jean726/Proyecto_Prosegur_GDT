@model ProsegurGDT.Web.Models.DashboardTelefonistaViewModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="pg-dash-cab">
    <div>
        <h1>Inicio</h1>
        <p>Contactos pendientes y citas programadas</p>
    </div>
    <a asp-controller="Citas" asp-action="Index" class="btn btn-primary">Gestionar citas</a>
</div>

@if (Model.IntentosAgotados > 0)
{
    <div class="pg-aviso">
        @Model.IntentosAgotados @(Model.IntentosAgotados == 1 ? "tarjeta con intentos de contacto agotados: ya está escalada" : "tarjetas con intentos de contacto agotados: ya están escaladas") al Supervisor
    </div>
}

<div class="pg-metricas">
    <div class="pg-tarjeta pg-metrica pg-metrica-azul"><small>Pendientes de contacto</small><strong>@Model.PendientesContacto</strong></div>
    <div class="pg-tarjeta pg-metrica pg-metrica-riesgo"><small>Intentos agotados</small><strong>@Model.IntentosAgotados</strong></div>
    <div class="pg-tarjeta pg-metrica pg-metrica-ok"><small>Citas programadas</small><strong>@Model.CitasProgramadas</strong></div>
</div>

<div class="pg-tarjeta pg-bloque">
    <h2 class="h6 mb-2">Próximas citas</h2>
    @if (Model.ProximasCitas.Count == 0)
    {
        <p class="text-muted mb-2">No hay citas próximas.</p>
    }
    else
    {
        <table class="table mb-2">
            <thead>
                <tr><th>Tarjeta</th><th>Cliente</th><th>Fecha y hora</th><th>Estado</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.ProximasCitas)
                {
                    <tr>
                        <td>@c.Tarjeta</td>
                        <td>@c.Cliente</td>
                        <td>@c.Fecha.ToString("dd/MM") @c.Hora.ToString("HH:mm")</td>
                        <td><span class="pg-estado pg-estado-custodia">Programada</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <a asp-controller="Citas" asp-action="Index">Ir a citas con clientes →</a>
</div>