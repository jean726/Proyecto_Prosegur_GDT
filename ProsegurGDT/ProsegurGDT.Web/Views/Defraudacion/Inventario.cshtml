@model List<ProsegurGDT.Web.Models.InventarioFilaVM>
@using ProsegurGDT.Web.Domain
@using ProsegurGDT.Web.Services
@{
    ViewData["Title"] = "Inventario de bóveda";
    var fraude = Model.Count(i => i.EstadoFisico == DefraudacionService.EstadoFisicoFraude);
}
<div class="pg-encabezado">
    <div>
        <h1>Inventario de bóveda</h1>
        <p class="pg-subtitulo">@Model.Count tarjetas en custodia · @fraude con etiqueta de fraude</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Apartado de defraudación</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Imprimir</button>
    </div>
</div>

<div class="pg-tarjeta pg-tarjeta-tabla">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Tarjeta</th><th>Titular</th><th>Ubicación</th><th>Estado físico</th><th>Actualizado</th></tr></thead>
            <tbody>
                @foreach (var i in Model)
                {
                    var esFraude = i.EstadoFisico == DefraudacionService.EstadoFisicoFraude;
                    <tr>
                        <td class="fw-semibold">@i.Codigo</td>
                        <td>@i.Cliente</td>
                        <td>@i.Ubicacion</td>
                        <td><span class="pg-estado @(esFraude ? "pg-estado-riesgo" : "pg-estado-custodia")">@i.EstadoFisico</span></td>
                        <td>@HoraLima.Convertir(i.FechaActualizacion).ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">La bóveda no tiene tarjetas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
