@model ProsegurGDT.Web.Models.ImportarFichaVM
@{
    ViewData["Title"] = "Generar ficha de clientes";
}
<h2>Generar ficha de clientes</h2>
<p class="text-muted">Cargue el archivo CSV remitido por UNIBANCA. Cabecera: <code>CodigoTarjeta;NombreCompleto;Documento;Telefono;Direccion</code>. La cantidad de filas debe coincidir con las tarjetas contadas del lote.</p>
@if (Model.Errores.Count > 0)
{
    <div class="alert alert-danger"><ul class="mb-0">@foreach (var e in Model.Errores) {
        <li>@e</li>
    }
</ul></div>
}
<form asp-action="Importar" method="post" enctype="multipart/form-data" class="col-md-7">
    <div class="mb-3">
        <label asp-for="LoteId" class="form-label">Lote ingresado</label>
        <select asp-for="LoteId" class="form-select" asp-items="Model.Lotes"><option value="">-- Seleccione --</option></select>
    </div>
    <div class="mb-3"><label asp-for="Archivo" class="form-label">Archivo CSV</label><input asp-for="Archivo" type="file" accept=".csv" class="form-control" /></div>
    <button class="btn btn-success">Generar ficha</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>