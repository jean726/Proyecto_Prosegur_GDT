@model IEnumerable<ProsegurGDT.Web.Domain.Tarjeta>
@using ProsegurGDT.Web.Domain
@{
    ViewData["Title"] = "Fichas de clientes"; string? q = ViewBag.Q;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Fichas de clientes</h2>
    @if (User.IsInRole(Roles.Supervisor))
    {
        <a asp-action="Importar" class="btn btn-primary">Generar ficha desde CSV</a>
    }
</div>
@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@q" class="form-control" placeholder="Código, nombre o documento" /></div>
    <div class="col-md-3">
        <select name="estado" class="form-select" asp-items="@Html.GetEnumSelectList<EstadoTarjeta>()"><option value="">Todos los estados</option></select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-secondary">Filtrar</button></div>
</form>
<table class="table table-sm table-hover align-middle">
    <thead class="table-light"><tr><th>Tarjeta</th><th>Cliente</th><th>Documento</th><th>Teléfono</th><th>Dirección</th><th>Estado</th><th>Datos</th><th></th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            var completos = FichaCliente.DatosCompletos(t.Cliente!);
            <tr>
                <td>@t.Codigo</td>
                <td>@t.Cliente!.NombreCompleto</td>
                <td>@t.Cliente.DocumentoIdentidad</td>
                <td>@(t.Cliente.Telefono ?? "—")</td>
                <td>@t.Cliente.Direccion</td>
                <td><span class="badge bg-secondary">@t.Estado.Texto()</span></td>
                <td>@if (completos) {
                    <span class="badge bg-success">Completos</span>
                } else
                {

                    <span class="badge bg-warning text-dark">Incompletos</span>
                }
            </td>
            <td>@if (User.IsInRole(Roles.Supervisor)) {
                <a asp-action="Editar" asp-route-id="@t.ClienteId" class="btn btn-sm btn-outline-primary">Corregir</a>
            }
        </td>
    </tr>
}
</tbody>
</table>