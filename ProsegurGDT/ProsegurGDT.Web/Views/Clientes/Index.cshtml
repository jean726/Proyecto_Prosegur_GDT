@model IEnumerable<ProsegurGDT.Web.Domain.Tarjeta>
@using ProsegurGDT.Web.Domain
@{
    ViewData["Title"] = "Fichas de clientes"; ViewData["Torre"] = true;
    var total = Model.Count();
    var incompletas = Model.Count(t => !FichaCliente.DatosCompletos(t.Cliente!));
}
<div class="pg-encabezado">
    <div>
        <h1>Fichas de clientes</h1>
        <p class="pg-subtitulo">@total tarjetas registradas · @incompletas con datos incompletos</p>
    </div>
    @if (User.IsInRole(Roles.Supervisor))
    {
        <a asp-action="Importar" class="btn btn-primary">+ Generar ficha desde CSV</a>
    }
</div>
@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
<div class="pg-tarjeta pg-tarjeta-tabla">
    <div class="pg-barra-tabla">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input id="pgBuscar" type="search" class="form-control" placeholder="Buscar tarjeta, nombre o documento" autocomplete="off" aria-label="Buscar por tarjeta, nombre o documento" />
            <select id="pgEstado" class="form-select" style="max-width: 220px" aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                @foreach (var e in Enum.GetValues<EstadoTarjeta>())
                {
                    <option value="@e">@e.TextoEstado()</option>
                }
            </select>
            <div class="form-check ms-1">
                <input id="pgSoloIncompletos" type="checkbox" class="form-check-input" />
                <label for="pgSoloIncompletos" class="form-check-label">Solo datos incompletos</label>
            </div>
            <span class="pg-subtitulo ms-auto">Mostrando <span id="pgMostrando">@total</span> de @total</span>
        </div>
    </div>
    <div class="table-responsive">
        <table id="pgTabla" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Tarjeta</th>
                    <th>Cliente</th>
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th>Datos</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    var completos = FichaCliente.DatosCompletos(t.Cliente!);
                    var clave = $"{t.Codigo} {t.Cliente!.NombreCompleto} {t.Cliente.DocumentoIdentidad}".ToLowerInvariant();
                    <tr data-buscar="@clave" data-estado="@t.Estado" data-incompletos="@(completos ? "false" : "true")">
                        <td><span class="fw-semibold">@t.Codigo</span></td>
                        <td>
                            <div class="fw-medium">@t.Cliente.NombreCompleto</div>
                            <div class="text-muted small">DNI @t.Cliente.DocumentoIdentidad</div>
                        </td>
                        <td>
                            <div>@(t.Cliente.Telefono ?? "—")</div>
                            <div class="text-muted small text-truncate" style="max-width: 320px" title="@t.Cliente.Direccion">@t.Cliente.Direccion</div>
                        </td>
                        <td><span class="pg-estado pg-estado-@t.Estado.TonoEstado()">@t.Estado.TextoEstado()</span></td>
                        <td>
                            @if (completos)
                            {
                                <span class="badge bg-success">Completos</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Incompletos</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (User.IsInRole(Roles.Supervisor))
                            {
                                <a asp-action="Editar" asp-route-id="@t.ClienteId" class="btn btn-sm btn-outline-primary">Corregir</a>
                            }
                        </td>
                    </tr>
                }
                <tr id="pgVacio" hidden>
                    <td colspan="6" class="text-center text-muted py-4">No se encontraron tarjetas con esos filtros.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        (function () {
            var buscar = document.getElementById('pgBuscar');
            var estado = document.getElementById('pgEstado');
            var soloIncompletos = document.getElementById('pgSoloIncompletos');
            var filas = document.querySelectorAll('#pgTabla tbody tr[data-buscar]');
            var mostrando = document.getElementById('pgMostrando');
            var vacio = document.getElementById('pgVacio');

            function filtrar() {
                var texto = buscar.value.trim().toLowerCase();
                var estadoSel = estado.value;
                var incompletos = soloIncompletos.checked;
                var n = 0;
                filas.forEach(function (f) {
                    var coincideTexto = f.getAttribute('data-buscar').indexOf(texto) !== -1;
                    var coincideEstado = estadoSel === '' || f.getAttribute('data-estado') === estadoSel;
                    var coincideDatos = !incompletos || f.getAttribute('data-incompletos') === 'true';
                    var visible = coincideTexto && coincideEstado && coincideDatos;
                    f.hidden = !visible;
                    if (visible) n++;
                });
                mostrando.textContent = n;
                vacio.hidden = n !== 0;
            }

            buscar.addEventListener('input', filtrar);
            estado.addEventListener('change', filtrar);
            soloIncompletos.addEventListener('change', filtrar);
            filtrar();
        })();
    </script>
}
