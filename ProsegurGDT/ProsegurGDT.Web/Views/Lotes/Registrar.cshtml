@model ProsegurGDT.Web.Models.RegistrarLoteVM
@{
    ViewData["Title"] = "Registrar lote"; ViewData["Torre"] = true;
}
<div class="pg-encabezado">
    <div>
        <a asp-action="Index" class="pg-subtitulo d-inline-block mb-1 text-decoration-none">← Volver a Ingreso de tarjetas</a>
        <h1>Registrar lote</h1>
        <p class="pg-subtitulo">Ingresa el remito, cuenta las tarjetas y genera la hoja de control de custodia.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="pg-alerta">@Model.Error</div>
}

<div class="pg-tarjeta pg-bloque">
    <div class="pg-linea pg-tono-custodia">
        <div class="pg-paso @(Model.RemitoEncontrado ? "hecho" : "actual")">
            <span class="pg-punto"></span>
            <span>Remito</span>
        </div>
        <div class="pg-paso @(Model.RemitoEncontrado ? "actual" : "")">
            <span class="pg-punto"></span>
            <span>Conteo físico</span>
        </div>
        <div class="pg-paso">
            <span class="pg-punto"></span>
            <span>Hoja de control</span>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="pg-tarjeta pg-bloque">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 mb-0">1. Datos del lote</h2>
                @if (Model.RemitoEncontrado)
                {
                    <span class="pg-estado pg-estado-custodia">Remito encontrado</span>
                }
            </div>
            <form asp-action="Buscar" method="post" class="row g-3 align-items-end">
                <div class="col-md-7">
                    <label asp-for="NumeroRemito" class="form-label">Número de remito *</label>
                    <input asp-for="NumeroRemito" class="form-control" placeholder="REM-0001" />
                </div>
                <div class="col-md-5">
                    <button type="submit" class="btn btn-outline-primary">Cargar remito</button>
                </div>
            </form>

            @if (Model.RemitoEncontrado)
            {
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted fw-normal">Entidad remitente</dt>
                    <dd class="col-sm-7 fw-medium">@(Model.Entidad ?? "—")</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Fecha de recepción</dt>
                    <dd class="col-sm-7">@Model.FechaRecepcion.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-5 text-muted fw-normal">Cantidad declarada</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.CantidadDeclarada</dd>
                </dl>
            }
        </div>

        @if (Model.RemitoEncontrado)
        {
            <div class="pg-tarjeta pg-bloque mb-0">
                <h2 class="h6 mb-3">2. Conteo físico</h2>
                <form asp-action="Registrar" method="post">
                    <input type="hidden" asp-for="RemitoId" />
                    <input type="hidden" asp-for="NumeroRemito" />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="CantidadContada" class="form-label">Tarjetas contadas *</label>
                            <input asp-for="CantidadContada" type="number" min="0" step="1" class="form-control" placeholder="0" />
                        </div>
                    </div>

                    <div id="indicador" class="mt-3" aria-live="polite">
                        <p class="pg-subtitulo mb-0">Ingresa la cantidad contada para comparar.</p>
                    </div>

                    <div class="pg-acciones">
                        <button type="submit" id="btnRegistrar" class="btn btn-primary" disabled>Registrar ingreso</button>
                        <button type="submit" id="btnDiscrepancia" class="btn btn-outline-danger d-none">Registrar discrepancia</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="pg-tarjeta pg-bloque h-100">
            <h2 class="h6 mb-3">¿Cómo funciona?</h2>
            <ol class="mb-3 ps-3">
                <li>Ingresa el número de remito y pulsa <strong>Cargar remito</strong>.</li>
                <li>Verifica la entidad y la cantidad declarada.</li>
                <li>Cuenta las tarjetas físicamente e ingresa el total.</li>
                <li>Si coincide, se genera la hoja de control de custodia.</li>
                <li>Si no coincide, se registra la discrepancia para revisión.</li>
            </ol>
            <div class="pg-aviso mb-0">
                Un remito ya ingresado en custodia no se puede volver a registrar.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.RemitoEncontrado)
    {
        <script>
            (function () {
                var declarada = @Model.CantidadDeclarada;
                var input = document.getElementById('CantidadContada');
                var btnOk = document.getElementById('btnRegistrar');
                var btnDisc = document.getElementById('btnDiscrepancia');
                var ind = document.getElementById('indicador');

                function evaluar() {
                    var v = input.value;
                    btnOk.disabled = true;
                    btnDisc.classList.add('d-none');

                    if (v === '') {
                        ind.innerHTML = '<p class="pg-subtitulo mb-0">Ingresa la cantidad contada para comparar.</p>';
                        return;
                    }

                    var n = Number(v);
                    if (!Number.isInteger(n) || n < 0) {
                        ind.innerHTML = '<div class="pg-aviso pg-aviso-riesgo mb-0">Ingresa un número entero mayor o igual a 0.</div>';
                        return;
                    }

                    var dif = n - declarada;
                    if (dif === 0) {
                        ind.innerHTML = '<div class="alert alert-success mb-0"><strong>Declaradas:</strong> ' + declarada +
                            ' · <strong>Contadas:</strong> ' + n + ' · <strong>Diferencia:</strong> 0<br>' +
                            'Las cantidades coinciden. Se generará la hoja de control.</div>';
                        btnOk.disabled = false;
                    } else {
                        ind.innerHTML = '<div class="pg-aviso pg-aviso-riesgo mb-0"><strong>Declaradas:</strong> ' + declarada +
                            ' · <strong>Contadas:</strong> ' + n + ' · <strong>Diferencia:</strong> ' + (dif > 0 ? '+' : '') + dif +
                            '<br>Discrepancia detectada. El lote quedará registrado como discrepancia y no ingresará en custodia.</div>';
                        btnDisc.classList.remove('d-none');
                    }
                }

                input.addEventListener('input', evaluar);
                evaluar();
            })();
        </script>
    }
}
