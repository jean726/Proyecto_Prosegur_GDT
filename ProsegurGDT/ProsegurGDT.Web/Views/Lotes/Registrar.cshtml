@model ProsegurGDT.Web.Models.RegistrarLoteVM
@{
    ViewData["Title"] = "Gestionar ingreso de tarjetas";
}

<h2>Gestionar ingreso de tarjetas</h2>
<p class="text-muted">Registre el lote recibido desde UNIBANCA y genere la hoja de control de custodia.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card mb-3">
    <div class="card-header">1. Datos del lote</div>
    <div class="card-body">
        <form asp-action="Buscar" method="post" class="row g-2">
            <div class="col-md-4">
                <label asp-for="NumeroRemito" class="form-label">Número de remito</label>
                <input asp-for="NumeroRemito" class="form-control" placeholder="REM-0001" />
            </div>
            <div class="col-md-3 align-self-end">
                <button type="submit" class="btn btn-outline-primary">Cargar remito</button>
            </div>
        </form>

        @if (Model.RemitoEncontrado)
        {
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Entidad remitente</label>
                    <input class="form-control" value="@Model.Entidad" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha de recepción</label>
                    <input class="form-control" value="@Model.FechaRecepcion.ToString("dd/MM/yyyy")" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cantidad declarada en el remito</label>
                    <input class="form-control" value="@Model.CantidadDeclarada" readonly />
                </div>
            </div>
        }
    </div>
</div>

@if (Model.RemitoEncontrado)
{
    <div class="card mb-3">
        <div class="card-header">2. Conteo físico</div>
        <div class="card-body">
            <form asp-action="Registrar" method="post">
                <input type="hidden" asp-for="RemitoId" />
                <input type="hidden" asp-for="NumeroRemito" />
                <div class="row">
                    <div class="col-md-4">
                        <label asp-for="CantidadContada" class="form-label">Tarjetas contadas</label>
                        <input asp-for="CantidadContada" type="number" min="0" class="form-control" />
                    </div>
                </div>
                <div id="indicador" class="mt-3"></div>
                <div class="mt-3">
                    <button type="submit" id="btnRegistrar" class="btn btn-success" disabled>Registrar ingreso</button>
                    <button type="submit" id="btnDiscrepancia" class="btn btn-warning d-none">Registrar discrepancia</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    @if (Model.RemitoEncontrado)
    {
        <script>
            const declarada = @Model.CantidadDeclarada;
            const input = document.getElementById('CantidadContada');
            const btnOk = document.getElementById('btnRegistrar');
            const btnDisc = document.getElementById('btnDiscrepancia');
            const ind = document.getElementById('indicador');

            function evaluar() {
                const v = input.value;
                btnOk.disabled = true;
                btnDisc.classList.add('d-none');
                if (v === '') { ind.innerHTML = ''; return; }
                const n = parseInt(v, 10);
                if (n === declarada) {
                    ind.innerHTML = '<div class="alert alert-success mb-0">Las cantidades coinciden.</div>';
                    btnOk.disabled = false;
                } else {
                    ind.innerHTML = '<div class="alert alert-danger mb-0">Discrepancia: declaradas ' + declarada +
                        ', contadas ' + n + ' (diferencia ' + (n - declarada) + '). El lote no puede ser registrado.</div>';
                    btnDisc.classList.remove('d-none');
                }
            }
            input.addEventListener('input', evaluar);
            evaluar();
        </script>
    }
}