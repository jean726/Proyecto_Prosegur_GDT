@model ProsegurGDT.Web.Models.GestionarCitaVM
@using ProsegurGDT.Web.Domain
@{
    ViewData["Title"] = "Gestionar cita";
    var c = Model.Tarjeta!.Cliente!;
    var items = Enum.GetValues<ResultadoLlamada>().Select(r => new SelectListItem(r.Texto(), r.ToString())).ToList();
    var mostrarCita = Model.Resultado == ResultadoLlamada.Exitoso;
    var pct = Model.MaxIntentos > 0 ? Math.Min(100, Model.IntentosNoContacto * 100 / Model.MaxIntentos) : 0;
}
<div class="pg-encabezado">
    <div>
        <a asp-action="Index" class="pg-subtitulo d-inline-block mb-1 text-decoration-none">← Volver a Citas</a>
        <h1>Gestionar cita con cliente</h1>
        <p class="pg-subtitulo">Tarjeta @Model.Tarjeta.Codigo · @c.NombreCompleto · DNI @c.DocumentoIdentidad</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="pg-alerta">@Model.Error</div>
}

<div class="pg-tarjeta pg-bloque">
    <partial name="_LineaTiempoEstado" model="Model.Tarjeta.Estado" />
</div>

<div class="row g-3 mb-1">
    <div class="col-lg-7">
        <div class="pg-tarjeta pg-bloque h-100">
            <h2 class="h6 mb-3">Datos del cliente y la tarjeta</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted fw-normal">Cliente</dt>
                <dd class="col-sm-8 fw-medium">@c.NombreCompleto</dd>

                <dt class="col-sm-4 text-muted fw-normal">Documento</dt>
                <dd class="col-sm-8">DNI @c.DocumentoIdentidad</dd>

                <dt class="col-sm-4 text-muted fw-normal">Teléfono</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(c.Telefono) ? "—" : c.Telefono)</dd>

                <dt class="col-sm-4 text-muted fw-normal">Dirección</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(c.Direccion) ? "—" : c.Direccion)</dd>

                <dt class="col-sm-4 text-muted fw-normal">Tarjeta</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Tarjeta.Codigo</dd>

                <dt class="col-sm-4 text-muted fw-normal">Estado</dt>
                <dd class="col-sm-8">
                    <span class="pg-estado pg-estado-@Model.Tarjeta.Estado.TonoEstado()">@Model.Tarjeta.Estado.TextoEstado()</span>
                </dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="pg-tarjeta pg-bloque h-100">
            <h2 class="h6 mb-3">Seguimiento</h2>
            <div class="pg-barra-fila">
                <span>Sin contacto</span>
                <div class="pg-barra-pista"><span style="width:@pct%"></span></div>
                <strong>@Model.IntentosNoContacto</strong>
            </div>
            <p class="pg-subtitulo mb-3">@Model.IntentosNoContacto de @Model.MaxIntentos intentos registrados.</p>
            @if (!Model.DatosCompletos)
            {
                <div class="pg-aviso mb-0">
                    Datos de contacto incompletos: solo puede registrar <strong>Datos insuficientes</strong> y avisar al Supervisor.
                </div>
            }
            else
            {
                <p class="pg-subtitulo mb-0">Datos de contacto completos. Puede registrar cualquier resultado de la llamada.</p>
            }
        </div>
    </div>
</div>

<form asp-action="Gestionar" method="post" class="pg-tarjeta pg-bloque">
    <input type="hidden" asp-for="TarjetaId" />
    <h2 class="h6 mb-3">Registrar resultado de la llamada</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Resultado" class="form-label">Resultado *</label>
            <select asp-for="Resultado" class="form-select" asp-items="items">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
        <div class="col-md-8">
            <label asp-for="Observaciones" class="form-label"></label>
            <input asp-for="Observaciones" class="form-control" maxlength="400" placeholder="Detalle breve de la llamada (opcional)" />
        </div>
    </div>

    <div id="bloqueCita" class="row g-3 mt-1 @(mostrarCita ? "" : "d-none")">
        <div class="col-12">
            <hr class="my-1" />
            <span class="pg-subtitulo">Complete los datos de la cita acordada con el cliente.</span>
        </div>
        <div class="col-md-3">
            <label asp-for="Fecha" class="form-label">Fecha de entrega</label>
            <input asp-for="Fecha" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Hora" class="form-label">Hora de entrega</label>
            <input asp-for="Hora" type="time" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Lugar" class="form-label">Lugar de entrega</label>
            <input asp-for="Lugar" class="form-control" maxlength="250" placeholder="Dirección o punto de entrega" />
        </div>
    </div>

    <div class="pg-acciones">
        <button type="submit" class="btn btn-primary">Registrar llamada</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

<div class="pg-tarjeta pg-tarjeta-tabla">
    <div class="pg-barra-tabla d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Historial de intentos</h2>
        <span class="pg-subtitulo">@Model.Historial.Count @(Model.Historial.Count == 1 ? "registro" : "registros")</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Resultado</th>
                    <th>Observaciones</th>
                    <th>Registrado por</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Historial)
                {
                    <tr>
                        <td class="text-nowrap">@HoraLima.Convertir(h.FechaHora).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@h.Resultado.Texto()</td>
                        <td>@(string.IsNullOrWhiteSpace(h.Observaciones) ? "—" : h.Observaciones)</td>
                        <td>@(h.Usuario?.NombreCompleto ?? "—")</td>
                    </tr>
                }
                @if (!Model.Historial.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Sin intentos previos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById('Resultado');
            var bloque = document.getElementById('bloqueCita');

            function toggle() {
                bloque.classList.toggle('d-none', sel.value !== 'Exitoso');
            }

            sel.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
