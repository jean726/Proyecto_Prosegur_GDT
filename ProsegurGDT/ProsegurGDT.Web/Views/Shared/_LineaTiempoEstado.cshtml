@using ProsegurGDT.Web.Domain
@model EstadoTarjeta
@{
    var pasos = EtapasTarjeta.Nombres;
    var (paso, tono, texto) = EstadoTarjetaUi.Describir(Model);
}
<div class="pg-linea pg-tono-@tono">
    @for (var i = 0; i < pasos.Length; i++)
    {
        <div class="pg-paso @(i < paso ? "hecho" : i == paso ? "actual" : "")">
            <span class="pg-punto"></span>
            <span>@pasos[i]</span>
        </div>
    }
</div>
<span class="pg-estado pg-estado-@tono">@texto</span>