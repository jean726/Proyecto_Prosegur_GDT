@using ProsegurGDT.Web.Domain
@{ var ctrlActual = ViewContext.RouteData.Values["controller"]?.ToString(); }
@if (User.Identity?.IsAuthenticated == true)
{
    foreach (var op in MenuCatalogo.Items.Where(o => o.Roles.Any(r => User.IsInRole(r))))
    {
        if (op.Disponible)
        {
            <a class="pg-item @(op.Controller == ctrlActual ? "activo" : "")" asp-area="" asp-controller="@op.Controller" asp-action="@op.Action">@op.Texto</a>
        }
        else
        {
            <span class="pg-item-off" title="Próximamente">@op.Texto</span>
        }
    }
}