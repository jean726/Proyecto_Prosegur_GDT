<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prosegur GDT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProsegurGDT.Web.styles.css" asp-append-version="true" />
</head>
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var ctrlActual = ViewContext.RouteData.Values["controller"]?.ToString();
}
<body class="@(autenticado ? "pg-con-lateral" : "pg-sin-lateral")">
    @if (autenticado)
    {
        <aside class="pg-lateral">
            <a class="pg-marca" asp-area="" asp-controller="Home" asp-action="Index">
                <img class="pg-logo" src="~/img/logo-prosegur.png" alt="" onerror="this.style.display='none'" />
                <span>Prosegur GDT</span>
            </a>
            <nav class="pg-menu">
                <a class="pg-item @(ctrlActual == "Home" ? "activo" : "")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                <partial name="_MenuPorRol" />
            </nav>
            <div class="pg-lateral-pie">
                <partial name="_LoginPartial" />
            </div>
        </aside>
    }
    else
    {
        <header class="pg-barra">
            <a class="pg-marca" asp-area="" asp-controller="Home" asp-action="Index">
                <img class="pg-logo" src="~/img/logo-prosegur.png" alt="" onerror="this.style.display='none'" />
                <span>Prosegur GDT</span>
            </a>
            <partial name="_LoginPartial" />
        </header>
    }

    <main role="main" class="pg-contenido">
        @RenderBody()
        <footer class="pg-pie">&copy; 2026 - Prosegur GDT</footer>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>