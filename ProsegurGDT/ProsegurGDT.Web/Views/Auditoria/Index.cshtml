@model IEnumerable<ProsegurGDT.Web.Domain.AuditLog>
@using ProsegurGDT.Web.Domain
@{
    ViewData["Title"] = "Auditoría"; ViewData["Torre"] = true; string? q = ViewBag.Q;
    int total = ViewBag.Total, pagina = ViewBag.Pagina, paginas = ViewBag.Paginas;
}
<div class="pg-encabezado">
    <div>
        <h1>Historial de auditoría</h1>
        <p class="pg-subtitulo">@total @(total == 1 ? "registro" : "registros")@(string.IsNullOrWhiteSpace(q) ? "" : " para «" + q + "»")@(paginas > 1 ? $" · página {pagina} de {paginas}" : "")</p>
    </div>
</div>
<div class="pg-tarjeta pg-tarjeta-tabla">
    <form method="get" class="pg-barra-tabla d-flex gap-2 flex-wrap">
        <input name="q" value="@q" class="form-control" placeholder="Usuario, acción o detalle" aria-label="Filtrar el historial" />
        <button class="btn btn-outline-secondary">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(q))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Quitar filtro</a>
        }
    </form>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th scope="col">Fecha y hora</th><th scope="col">Usuario</th><th scope="col">Acción</th><th scope="col">Entidad</th><th scope="col">Detalle</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="text-nowrap pg-t-mono">@HoraLima.Convertir(a.FechaHoraUtc).ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@a.UsuarioNombre</td>
                        <td>@a.Accion</td>
                        <td>@a.Entidad @a.EntidadId</td>
                        <td>@a.Detalle</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay registros que coincidan.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (paginas > 1)
    {
        <nav class="pg-barra-tabla d-flex gap-2 justify-content-end align-items-center" aria-label="Páginas del historial">
            @if (pagina > 1)
            {
                <a asp-action="Index" asp-route-q="@q" asp-route-pagina="@(pagina - 1)" class="btn btn-sm btn-outline-secondary">← Más recientes</a>
            }
            <span class="pg-subtitulo">Página @pagina de @paginas</span>
            @if (pagina < paginas)
            {
                <a asp-action="Index" asp-route-q="@q" asp-route-pagina="@(pagina + 1)" class="btn btn-sm btn-outline-secondary">Más antiguos →</a>
            }
        </nav>
    }
</div>
