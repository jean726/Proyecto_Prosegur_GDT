@model IEnumerable<ProsegurGDT.Web.Domain.AlertaDireccion>
@{ ViewData["Title"] = "Alertas de direcciones"; ViewData["Torre"] = true; }
<div class="pg-encabezado">
    <div>
        <h1>Alertas pendientes de revisión</h1>
        <p class="pg-subtitulo">Compare ambas direcciones. Al confirmar, la tarjeta queda no clasificable y su cita vigente se anula.</p>
    </div>
</div>
@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
<div class="pg-tarjeta pg-tarjeta-tabla">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Tarjeta</th><th>Dirección de la tarjeta</th><th>Dirección registrada</th><th>Puntaje</th><th>Detalle</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><span class="text-nowrap fw-semibold">@a.Tarjeta!.Codigo</span><div class="small text-muted">@a.Tarjeta.Cliente!.NombreCompleto</div></td>
                        <td>@a.Tarjeta.Cliente.Direccion</td>
                        <td>@a.DireccionFraudulenta!.DireccionOriginal</td>
                        <td>
                            @if (a.Nivel == ProsegurGDT.Web.Domain.NivelAlerta.Alta) { <span class="badge bg-danger">Alta @a.Puntaje.ToString("P0")</span> }
                            else { <span class="badge bg-warning text-dark">Media @a.Puntaje.ToString("P0")</span> }
                        </td>
                        <td class="small">@a.Detalle</td>
                        <td class="text-end text-nowrap">
                            <form asp-action="ResolverAlerta" asp-route-id="@a.Id" method="post">
                                <button name="confirmar" value="true" class="btn btn-sm btn-danger"
                                        data-confirmar="¿Confirmar fraude? La tarjeta quedará no clasificable.">Confirmar fraude</button>
                                <button name="confirmar" value="false" class="btn btn-sm btn-outline-secondary">Descartar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No hay alertas pendientes.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
