@model ProsegurGDT.Web.Models.ReporteDensidadVM
@using ProsegurGDT.Web.Domain
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reporte de densidad - @Model.CodigoHojaControl</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { padding: 24px; color: #111418; }
        @@media screen and (max-width: 600px) { table { display: block; overflow-x: auto; } }
        h1 { font-size: 1.4rem; margin-bottom: 4px; }
        .meta { color: #555; margin-bottom: 16px; }
        table { width: 100%; }
        @@media print { .no-imprimir { display: none !important; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="no-imprimir mb-3 d-flex gap-2">
        <button type="button" class="btn btn-primary" data-accion="imprimir">Imprimir</button>
        <button type="button" class="btn btn-outline-secondary" data-accion="cerrar">Cerrar</button>
    </div>

    <h1>Prosegur GDT — Reporte de densidad de entregas</h1>
    <div class="meta">
        Lote @Model.CodigoHojaControl · Remito @Model.Remito<br />
        Generado por @Model.GeneradoPor el @HoraLima.Convertir(Model.FechaGeneracion!.Value).ToString("dd/MM/yyyy HH:mm")
        · Estado: @Model.Estado!.Value.Texto()
    </div>

    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr><th scope="col">Zona</th><th scope="col" class="text-end">Tarjetas</th><th scope="col" class="text-end">No clasificables</th><th scope="col">Tipo de repartidor</th><th scope="col">Alerta</th></tr>
        </thead>
        <tbody>
            @foreach (var z in Model.Zonas)
            {
                <tr>
                    <td>@z.ZonaNombre</td>
                    <td class="text-end">@z.CantidadTarjetas</td>
                    <td class="text-end">@z.CantidadNoClasificables</td>
                    <td>@z.TipoRepartidorRequerido.Texto()</td>
                    <td>@(z.TieneAlerta ? "Con alerta" : "—")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td>Total (@Model.Zonas.Count zonas)</td>
                <td class="text-end">@Model.TotalTarjetas</td>
                <td class="text-end">@Model.TotalNoClasificables</td>
                <td></td>
                <td>@Model.ZonasConAlerta con alerta</td>
            </tr>
        </tfoot>
    </table>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
