@model ProsegurGDT.Web.Models.ReporteDensidadVM
@using ProsegurGDT.Web.Domain
@{
    ViewData["Title"] = "Reporte de densidad";
}
<div class="pg-encabezado">
    <div>
        <h1>Reporte de densidad de entregas</h1>
        <p class="pg-subtitulo">Lote @Model.CodigoHojaControl · Remito @Model.Remito</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        @if (Model.Existe)
        {
            <a asp-action="Imprimir" asp-route-id="@Model.ReporteId" class="btn btn-primary" target="_blank" rel="noopener">Imprimir</a>
        }
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
@if (Model.Bloqueo is not null)
{
    <div class="pg-aviso">@Model.Bloqueo</div>
}

@if (Model.Zonas.Count > 0)
{
    <div class="pg-metricas">
        <div class="pg-tarjeta pg-metrica pg-metrica-azul"><small>Tarjetas</small><strong>@Model.TotalTarjetas</strong></div>
        <div class="pg-tarjeta pg-metrica"><small>Zonas</small><strong>@Model.Zonas.Count</strong></div>
        <div class="pg-tarjeta pg-metrica pg-metrica-riesgo"><small>No clasificables</small><strong>@Model.TotalNoClasificables</strong></div>
        <div class="pg-tarjeta pg-metrica pg-metrica-riesgo"><small>Zonas con alerta</small><strong>@Model.ZonasConAlerta</strong></div>
    </div>

    @if (Model.Existe)
    {
        <div class="pg-tarjeta pg-bloque mb-3">
            <span class="pg-estado @(Model.Estado == EstadoReporteDensidad.Revisado ? "pg-estado-entrega" : "pg-estado-custodia")">@Model.Estado!.Value.Texto()</span>
            <div class="text-muted small mt-2">
                Generado por @Model.GeneradoPor el @HoraLima.Convertir(Model.FechaGeneracion!.Value).ToString("dd/MM/yyyy HH:mm")
                @if (Model.RevisadoPor is not null)
                {
                    <span> · Revisado por @Model.RevisadoPor el @HoraLima.Convertir(Model.FechaRevision!.Value).ToString("dd/MM/yyyy HH:mm")</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="pg-aviso">Vista previa: el reporte aún no se ha generado. Al generarlo se guarda una copia fija de estas cifras.</div>
    }

    <div class="pg-tarjeta pg-tarjeta-tabla">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Zona</th><th class="text-end">Tarjetas</th><th class="text-end">No clasificables</th><th>Tipo de repartidor</th><th>Alerta</th></tr>
                </thead>
                <tbody>
                    @foreach (var z in Model.Zonas)
                    {
                        <tr>
                            <td class="fw-semibold">@z.ZonaNombre</td>
                            <td class="text-end">@z.CantidadTarjetas</td>
                            <td class="text-end">@z.CantidadNoClasificables</td>
                            <td>@z.TipoRepartidorRequerido.Texto()</td>
                            <td>@if (z.TieneAlerta) { <span class="pg-estado pg-estado-riesgo">Con alerta</span> } else { <span class="text-muted">—</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Existe && Model.Bloqueo is null)
    {
        <form asp-action="Generar" method="post" class="mt-3">
            <input type="hidden" name="loteId" value="@Model.LoteId" />
            <button class="btn btn-primary">Generar reporte</button>
        </form>
    }
}
